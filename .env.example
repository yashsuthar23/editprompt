PORT=3000
NODE_ENV=production
COOKIE_SECURE=false
SESSION_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gpt-5-mini
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ADMIN_EMAILS=
BUSINESS_NAME=EditPrompt
SUPPORT_EMAIL=support@editprompt.in
SITE_URL=https://editprompt.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- AI Media Studio (image + video generation) ----
# true = only local ComfyUI + configured Hugging Face provider; false = also allow Pollinations/Gemini where configured.
# Important: Hugging Face partner video providers can consume HF credits. Local ComfyUI is the genuinely local/free path.
FREE_ONLY_MEDIA=true
# Image model (Nano Banana family)
IMAGE_MODEL=gemini-2.5-flash-image
# Video model (Veo family)
VIDEO_MODEL=veo-3.1-fast-generate-preview
GEMINI_VIDEO_ENABLED=true
VEO_RESOLUTION=720p
# How long generated files stay on disk before cleanup
MEDIA_TTL_HOURS=48
# Only set this if you are in EU/UK/CH/MENA, where "allow_adult" is required
# VEO_PERSON_GENERATION=allow_adult


# ---- Media provider priority ----
# Image/video: Pollinations first -> local ComfyUI fallback.
# Get a server-side Pollinations key from enter.pollinations.ai.
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_VIDEO_MODEL=veo
POLLINATIONS_TIMEOUT_MS=120000
POLLINATIONS_VIDEO_TIMEOUT_MS=900000

# ---- Local ComfyUI fallback ----
# Start ComfyUI locally (default: http://127.0.0.1:8188).
COMFYUI_URL=
COMFYUI_INPUT_DIR=
COMFYUI_IMAGE_WORKFLOW=local-workflows/image.json
COMFYUI_VIDEO_WORKFLOW=local-workflows/video.json
COMFYUI_REQUEST_TIMEOUT_MS=30000
LOCAL_MEDIA_TIMEOUT_MS=1200000
LOCAL_VIDEO_FPS=24

# Free-only media via Hugging Face Inference Providers
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B
HF_I2V_MODEL=Wan-AI/Wan2.1-I2V-14B-720P
HF_VIDEO_PROVIDER=fal-ai
HF_TIMEOUT_MS=180000
HF_VIDEO_TIMEOUT_MS=900000
SMTP_VERIFY_ON_START=true
