PORT=3000
NODE_ENV=production
COOKIE_SECURE=false
SESSION_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gpt-5-mini
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ADMIN_EMAILS=
BUSINESS_NAME=EditPrompt
SUPPORT_EMAIL=support@editprompt.in
SITE_URL=https://editprompt.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- AI Media Studio (image + video generation) ----
FREE_ONLY_MEDIA=true
# Image model (Nano Banana family)
IMAGE_MODEL=gemini-2.5-flash-image
# Video model (Veo family)
VIDEO_MODEL=veo-3.1-fast-generate-preview
GEMINI_VIDEO_ENABLED=false
VEO_RESOLUTION=720p
# How long generated files stay on disk before cleanup
MEDIA_TTL_HOURS=720
# Only set this if you are in EU/UK/CH/MENA, where "allow_adult" is required
# VEO_PERSON_GENERATION=allow_adult



# ---- Remote video providers (recommended) ----
# Paid providers are opt-in. Keep API keys server-side; never expose them in frontend JS.
PAID_VIDEO_ENABLED=false
FAL_KEY=
FAL_VIDEO_T2V_MODEL=fal-ai/wan/v2.2-a14b/text-to-video
FAL_VIDEO_I2V_MODEL=fal-ai/wan/v2.2-a14b/image-to-video
FAL_VIDEO_RESOLUTION=720p
FAL_VIDEO_STEPS=27
FAL_VIDEO_QUALITY=high
FAL_VIDEO_TIMEOUT_MS=900000
FAL_PROMPT_EXPANSION=false

# Optional secondary fallback provider
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_T2V_MODEL=wan-video/wan-2.2-t2v-fast
REPLICATE_VIDEO_I2V_MODEL=wan-video/wan-2.2-i2v-fast
REPLICATE_VIDEO_RESOLUTION=480p
REPLICATE_VIDEO_TIMEOUT_MS=900000

# ---- Media provider priority ----
# Get a server-side Pollinations key from enter.pollinations.ai.
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_VIDEO_MODEL=veo
POLLINATIONS_TIMEOUT_MS=120000
POLLINATIONS_VIDEO_TIMEOUT_MS=900000

# Free-only media via Hugging Face Inference Providers
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B
HF_I2V_MODEL=Wan-AI/Wan2.1-I2V-14B-720P
HF_VIDEO_PROVIDER=zerogpu-space
HF_ZEROGPU_SPACE_URL=https://openking-wan2-video-generation.hf.space
HF_ZEROGPU_TIMEOUT_MS=240000
HF_ZEROGPU_STEPS=30
HF_ZEROGPU_GUIDANCE=5.0
HF_TIMEOUT_MS=180000
HF_VIDEO_TIMEOUT_MS=900000
SMTP_VERIFY_ON_START=true

# Public base URL for generated-media share links.
PUBLIC_MEDIA_BASE_URL=



